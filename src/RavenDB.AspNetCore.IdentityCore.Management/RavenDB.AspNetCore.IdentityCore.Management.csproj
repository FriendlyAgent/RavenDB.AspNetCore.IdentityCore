<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Management and diagnostic tools for RavenDB ASP.NET Core Identity Compare Exchange reservations. Detect orphaned, pending, and missing reservations. Migrate between enforced and unenforced uniqueness constraints.</Description>
    <Copyright>Copyright 2025</Copyright>
    <Title>RavenDB AspNetCore IdentityCore Management</Title>
    <AssemblyTitle>RavenDB AspNetCore IdentityCore Management</AssemblyTitle>
    <Authors>FriendlyAgent</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>RavenDB.AspNetCore.IdentityCore.Management</AssemblyName>
    <PackageId>RavenDB.AspNetCore.IdentityCore.Management</PackageId>
    <PackageTags>nosql;ravendb;raven;identity;management;compare-exchange;reservations;diagnostics;migration</PackageTags>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageIcon>logo-for-nuget.png</PackageIcon>
    <PackageProjectUrl>https://github.com/FriendlyAgent/RavenDB.AspNetCore.IdentityCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/FriendlyAgent/RavenDB.AspNetCore.IdentityCore</RepositoryUrl>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>

    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageReleaseNotes>See CHANGELOG.md for details</PackageReleaseNotes>

    <!-- NuGet Package Generation -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Support RavenDB 6.x and 7.x (6.0.2 and above) -->
    <PackageReference Include="RavenDB.Client" Version="[6.0.2,8.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RavenDB.AspNetCore.IdentityCore\RavenDB.AspNetCore.IdentityCore.csproj" />
  </ItemGroup>

  <!-- Package files -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\logo-for-nuget.png" Pack="true" PackagePath="\" Condition="Exists('..\..\logo-for-nuget.png')" />
  </ItemGroup>
</Project>
